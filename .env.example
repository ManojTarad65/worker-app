# ===================================================
# Local Task Marketplace Environment Configuration
# ===================================================

# Node Environment
NODE_ENV=development

# Backend API Configuration
PORT=3000
API_URL=http://localhost:3000

# PostgreSQL / PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full Database Connection String (Used by ORM/Prisma/TypeORM later)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace_dev?schema=public

# Redis Configuration (Cache & Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Mobile App Environment
EXPO_PUBLIC_API_URL=http://localhost:3000
